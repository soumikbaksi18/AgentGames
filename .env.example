# Copy to .env for local runs. NEVER commit .env. On the server, secrets live
# in /etc/agentgames/agent.env and are set with deploy/set-secret.sh.

# ---- Secrets (required / optional) ----
# From the Agent Games dashboard -> "Rotate Secret" (one-time plaintext).
AGENT_GAMES_HMAC_SECRET=
# Kurier API key. Optional: enables background zkVerify submission of our proofs.
KURIER_API_KEY=

# ---- zkVerify / Kurier ----
# testnet first. On testnet the VK is registered automatically on first proof.
KURIER_NETWORK=testnet
# Override the vk hash (mainnet default is the platform's registered gatekeeper vk_hash).
KURIER_VK_HASH=

# ---- Circuit ----
# How the string task_id maps to the circuit's taskId field: keccak | sha256 | hexdigits
TASK_ID_ENCODING=keccak

# ---- Server ----
PORT=8080
HOST=127.0.0.1
AGENT_PATH=/agent
HARD_DEADLINE_MS=50000
DEADLINE_SAFETY_MS=5000
MAX_TASK_AGE_MS=600000
MAX_CONCURRENT_PROOFS=2
DATA_DIR=./data
LOG_LEVEL=info
