{
  "name": "agentgames-gatekeeper",
  "version": "0.1.0",
  "description": "Proof Gatekeeper agent for zkVerify Agent Games",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test --test-force-exit test/*.test.ts",
    "harness": "tsx test/harness.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
